[Unit]
Description=Podman:nsfw-check-api
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/git/nsfw-check-api
ExecStart=/usr/bin/podman-compose -f /home/git/nsfw-check-api/docker-compose.yml up
ExecStop=/usr/bin/podman-compose -f /home/git/nsfw-check-api/docker-compose.yml down
Restart=on-failure

[Install]
WantedBy=multi-user.target
